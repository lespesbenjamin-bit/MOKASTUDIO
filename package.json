{
  "name": "moka-studio-business-hub",
  "version": "0.1.0",
  "description": "Moka Studio Business Hub — CRM, contrats, commissions et prévisionnel",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:test-rls": "node scripts/test-rls.mjs",
    "db:test": "npm run -s db:verify && npm run -s db:test-rls && npm run -s db:test-crm && npm run -s db:test-import && npm run -s db:test-sales && npm run -s db:test-dashboard && npm run -s db:test-map && npm run -s db:test-projects && npm run -s db:test-controle",
    "db:test-crm": "node scripts/test-crm.mjs",
    "db:test-import": "node scripts/test-import.mjs",
    "db:test-sales": "node scripts/test-sales.mjs",
    "db:test-dashboard": "node scripts/test-dashboard.mjs",
    "test:e2e": "node scripts/e2e-demo.mjs",
    "db:test-controle": "node scripts/test-controle.mjs",
    "test:all": "npm run -s typecheck && npm test && npm run -s db:test && npm run -s test:edge && npm run -s build && npm run -s test:e2e && npm run -s test:e2e-portal",
    "db:test-map": "node scripts/test-map.mjs",
    "db:test-projects": "node scripts/test-projects.mjs",
    "test:edge": "node scripts/run-edge-test.mjs",
    "test:e2e-portal": "node scripts/e2e-portal.mjs"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.59.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "read-excel-file": "^9.3.12",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
